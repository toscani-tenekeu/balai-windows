{
  "name": "balai",
  "productName": "Balai",
  "version": "0.1.0",
  "description": "Keeps a Windows computer clean and healthy.",
  "author": "Toscani Tenekeu",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "homepage": "https://github.com/toscani-tenekeu/balai-windows",
  "scripts": {
    "build:renderer": "vue-tsc -p renderer/tsconfig.app.json --noEmit && vite build renderer",
    "build:main": "tsc -p tsconfig.main.json --noEmit && node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release": "npm run build && electron-builder --win nsis --x64 --publish always",
    "start": "npm run build && electron ."
  },
  "build": {
    "appId": "com.toscanitenekeu.balai",
    "productName": "Balai",
    "copyright": "Copyright © 2026 Toscani Tenekeu",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "Balai-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Balai",
      "uninstallDisplayName": "Balai",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "toscani-tenekeu",
        "repo": "balai-windows",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.74.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@unovis/ts": "^1.8.1",
    "@unovis/vue": "^1.8.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.14"
  }
}
